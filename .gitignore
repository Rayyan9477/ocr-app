# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build
package-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (but keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local testing files
*test*.sh
*test*.js
test-*.js
test-*.sh
*-test.js
*-test.sh
tests/
__tests__/
__mocks__/
coverage/

# Test PDFs and images
test_*.pdf
test_*.png
test_*.jpg
test_*.tif
test_*.tiff

# Tesseract language data (download with npm run setup:tessdata)
public/tessdata/
*.traineddata
*.traineddata.gz

# Integration test files
*-integration.js
*-integration-*.js

# Log files
logs/*.log
*.log
npm-debug.log*

# Processing files
*.processing
processing/
tmp/processing/

# Temporary files
tmp/*
!tmp/.gitkeep

# Deployment files
deployment/
deployment.zip
*.deployment
deployment-*.zip

# Processed files
processed/*
!processed/.gitkeep

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

*.pyc
__pycache__/
*.safetensors
nanovlm_env
nanovlm_env/
*.bak
*.fix