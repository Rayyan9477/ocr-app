# Test Dockerfile for PaddleOCR dependencies
FROM python:3.9-slim

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1

# Install system dependencies including OpenGL libraries for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libfontconfig1 \
    libxcb1 \
    libxss1 \
    libasound2 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Test OpenCV import
RUN pip install opencv-python-headless==4.8.1.78 && \
    python -c "import cv2; print('OpenCV import successful')"

# Test PaddleOCR import
RUN pip install paddlepaddle==2.6.1 paddleocr==2.7.3 && \
    python -c "from paddleocr import PaddleOCR; print('PaddleOCR import successful')"
