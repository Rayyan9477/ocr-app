# HIPAA Compliance Configuration

# Session Management
SESSION_TIMEOUT=15 # minutes
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESIDE=strict

# Storage Configuration
STORAGE_ENCRYPTION_KEY=your-secure-key-here
STORAGE_ENCRYPTION_ALGORITHM=AES-256-GCM
TEMP_FILE_RETENTION=24 # hours

# Audit Settings
ENABLE_AUDIT_LOGS=true
AUDIT_LOG_RETENTION=6 # years (HIPAA requirement)

# Security Settings
TLS_VERSION=TLSv1.3
MINIMUM_KEY_LENGTH=256
ENABLE_AT_REST_ENCRYPTION=true

# Access Control
REQUIRE_2FA=true
MAX_LOGIN_ATTEMPTS=3
PASSWORD_EXPIRY_DAYS=90

# Monitoring
ENABLE_ACTIVITY_MONITORING=true
ALERT_ON_SUSPICIOUS_ACTIVITY=true
