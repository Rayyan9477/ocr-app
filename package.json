{
  "name": "OCR-Project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:no-warnings": "NODE_NO_WARNINGS=1 next start --no-warnings",
    "dev": "chmod +x ./ensure-permissions.sh ./check-jbig2.sh ./setup-worker-script.sh && ./ensure-permissions.sh && ./setup-worker-script.sh && next dev",
    "build": "chmod +x ./setup-worker-script.sh && ./setup-worker-script.sh && next build",
    "start": "chmod +x ./ensure-permissions.sh ./check-jbig2.sh ./setup-worker-script.sh && ./ensure-permissions.sh && ./setup-worker-script.sh && next start",
    "lint": "next lint",
    "check-jbig2": "chmod +x ./check-jbig2.sh && ./check-jbig2.sh",
    "setup-deps": "apt-get update && apt-get install -y imagemagick pdftk tesseract-ocr poppler-utils ghostscript && sed -i 's/rights=\"none\" pattern=\"PDF\"/rights=\"read|write\" pattern=\"PDF\"/' /etc/ImageMagick-6/policy.xml || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup-vlm": "echo 'VLM setup is now handled automatically through @huggingface/transformers'",
    "make-extractable": "node make-extractable-pdf.js",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@huggingface/transformers": "^3.5.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@types/winston": "^2.4.4",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.20",
    "axios": "^1.9.0",
    "canvas": "^2.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.28.0",
    "form-data": "^4.0.2",
    "fuse.js": "^7.1.0",
    "img2pdf": "^1.0.11",
    "lucide-react": "^0.518.0",
    "next": "15.2.4",
    "next-themes": "^0.4.4",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.3.136",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.58.1",
    "sharp": "^0.32.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.0.4",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.32",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "assert": "^2.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mocha": "^10.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
