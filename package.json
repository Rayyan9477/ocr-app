{
  "name": "OCR-Project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:no-warnings": "NODE_OPTIONS='--no-warnings' next dev",
    "build": "next build",
    "start": "next start",
    "start:no-warnings": "NODE_OPTIONS='--no-warnings' next start",
    "lint": "next lint",
    "test": "jest --config jest.config.js",
    "test:nanovlm": "node dist/test/test-nanovlm.js",
    "test:nanovlm:watch": "nodemon -x 'pnpm run test:nanovlm' -w test/test-nanovlm.ts -w lib/nano-vlm-service.ts",
    "test:nanovlm:comprehensive": "./test-nanovlm-comprehensive.sh",
    "setup:nanovlm": "pnpm run build:ts && node dist/scripts/setup-nanovlm.js",
    "verify:nanovlm": "chmod +x ./verify-nanovlm-integration.sh && ./verify-nanovlm-integration.sh",
    "build:nanovlm": "chmod +x ./build-nanovlm.sh && ./build-nanovlm.sh",
    "build:ts": "tsc",
    "pretest": "pnpm run build:ts",
    "check-jbig2": "chmod +x ./check-jbig2.sh && ./check-jbig2.sh",
    "setup-deps": "apt-get update && apt-get install -y imagemagick pdftk && sed -i 's/rights=\"none\" pattern=\"PDF\"/rights=\"read|write\" pattern=\"PDF\"/' /etc/ImageMagick-6/policy.xml || true",
    "api:dev": "node dev-server.js",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run api:dev\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
