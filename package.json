{
  "name": "OCR-Project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "chmod +x ./ensure-permissions.sh ./check-jbig2.sh && ./ensure-permissions.sh && next dev",
    "build": "next build",
    "start": "node server.js",
    "start:azure": "chmod +x ./start.sh && ./start.sh",
    "start:next": "next start",
    "start:custom": "node server.cjs",
    "start:local": "chmod +x ./ensure-permissions.sh ./check-jbig2.sh && ./ensure-permissions.sh && next start",
    "lint": "next lint",
    "check-jbig2": "chmod +x ./check-jbig2.sh && ./check-jbig2.sh",
    "setup-deps": "apt-get update && apt-get install -y imagemagick pdftk && sed -i 's/rights=\"none\" pattern=\"PDF\"/rights=\"read|write\" pattern=\"PDF\"/' /etc/ImageMagick-6/policy.xml || true",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "remove-python": "chmod +x ./remove-python-dependencies.sh && ./remove-python-dependencies.sh",
    "clean": "rm -rf .next node_modules",
    "enhanced-ocr": "npx ts-node bin/enhanced-ocr.ts",
    "test:enhanced-ocr": "chmod +x ./test-enhanced-preprocessing.sh && ./test-enhanced-preprocessing.sh",
    "setup:enhanced-ocr": "npx ts-node -e \"require('./lib/enhanced-ocr-config').createDefaultEnvConfig()\"",
    "validate:enhanced-ocr": "npx ts-node -e \"require('./lib/enhanced-ocr-config').initializeEnhancedOCR()\"",
    "postinstall": "echo 'Post-install completed'",
    "prestart": "echo 'Starting OCR application...'"
  },
  "dependencies": {
    "@azure/arm-appservice": "^17.0.0",
    "@azure/arm-resources": "^6.1.0",
    "@azure/identity": "^4.10.2",
    "@hookform/resolvers": "^3.9.1",
    "@panva/hkdf": "^1.2.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/archiver": "^6.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^2.28.0",
    "embla-carousel-react": "8.5.1",
    "form-data": "^4.0.2",
    "fuse.js": "^7.1.0",
    "helmet": "^8.1.0",
    "input-otp": "1.4.1",
    "jsonwebtoken": "^9.0.2",
    "long": "^5.3.2",
    "lucide-react": "^0.454.0",
    "mock-aws-s3": "^4.0.2",
    "next": "15.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.4",
    "nock": "^14.0.5",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "react": "^18.2.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.0",
    "sharp": "^0.33.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^6.0.1",
    "vaul": "^0.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.34",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts", ".tsx"],
    "testEnvironment": "node",
    "passWithNoTests": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/",
      "/dist/",
      "/build/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", {
        "useESM": true
      }]
    }
  }
}
