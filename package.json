    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "eslint-config-next": "15.3.3",
    "postcss": "^8.4.35",
    "postcss-import": "^16.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
