    "embla-carousel-react": "^8.0.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "fuse.js": "^7.0.0",
    "input-otp": "^1.1.0",
    "lucide-react": "^0.323.0",
    "next": "14.1.0",
    "next-themes": "^0.2.1",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "python-shell": "^5.0.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
